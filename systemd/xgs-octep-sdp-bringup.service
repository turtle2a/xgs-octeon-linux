[Unit]
Description=Load OCTEP and bring up SDP packet rings
After=dkms.service systemd-modules-load.service systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
ExecStartPre=/sbin/modprobe octep
ExecStartPre=-/bin/sh -c 'echo 0 > /sys/bus/pci/devices/0000:01:00.0/rpc_allow_write'
ExecStart=/usr/local/xgs/linux/scripts/octep/sdp-bringup.sh
ExecStartPost=/usr/local/xgs/linux/scripts/octep/rpc-port-setup.sh
# NPU flow offload is on at every boot. The "-" keeps a failed enable (gate closed, FAIL in the journal) from restarting the bring-up on a running router.
ExecStartPost=-/usr/local/xgs/linux/scripts/octep/offload-enable.sh
TimeoutStartSec=10min
Restart=on-failure
RestartSec=30s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
