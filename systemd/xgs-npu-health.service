[Unit]
Description=Collect OCTEON TX NPU health and report to the kernel log
After=systemd-udev-settle.service xgs-octep-sdp-bringup.service

[Service]
Type=oneshot
ExecStart=/usr/local/xgs/linux/scripts/xgs/npu-health.sh collect
TimeoutStartSec=45s
StateDirectory=os-xgs-npu
ReadWritePaths=/run/lock
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes

[Install]
WantedBy=multi-user.target
