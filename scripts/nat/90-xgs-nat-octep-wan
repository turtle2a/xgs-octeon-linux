# NetworkManager dispatcher: re-apply the LAN NAT policy route whenever the
# WAN port (octep1) gets an address. A module reload or NPU reset re-creates the
# netdev and the kernel drops its routes, including the table 100 default.
# Install: install -m 755 scripts/nat/90-xgs-nat-octep-wan /etc/NetworkManager/dispatcher.d/
[ "$1" = octep1 ] || exit 0
case "$2" in
up | dhcp4-change) ;;
*) exit 0 ;;
esac
[ -e /etc/xgs-nat-off ] && exit 0
systemctl --no-block restart xgs-nat.service
